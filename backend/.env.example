# Replace every placeholder before using this file as .env.
APP_NAME="<application-name>"
APP_ENV="<development-test-or-production>"
DATABASE_URL="postgresql+psycopg://<username>:<password>@<host>:<port>/<database>"
FRONTEND_ORIGIN="<web-origin>"
DESKTOP_ORIGIN="<desktop-development-origin>"
GOOGLE_CLIENT_ID="<google-web-client-id>"
GOOGLE_CLIENT_SECRET="<google-web-client-secret>"
GOOGLE_REDIRECT_URI="<google-callback-url>"
AUTH_STATE_SECRET="<random-signing-secret-at-least-32-characters>"
SESSION_COOKIE_SECURE="<true-for-production-false-for-loopback-development>"
SESSION_TTL_SECONDS="<session-lifetime-in-seconds>"

# Optional server-only streaming transcription configuration.
# Obtain a Deepgram key and set it in your untracked .env; never in desktop/frontend.
TRANSCRIPTION_PROVIDER="deepgram"
DEEPGRAM_API_KEY="<your-deepgram-api-key>"
TRANSCRIPTION_MODEL="nova-3"
TRANSCRIPTION_LANGUAGE="en-US"
