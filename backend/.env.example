# Replace every placeholder before using this file as .env.
APP_NAME="<application-name>"
APP_ENV="<development-test-or-production>"
DATABASE_URL="postgresql+psycopg://<username>:<password>@<host>:<port>/<database>"
FRONTEND_ORIGIN="<web-origin>"
DESKTOP_ORIGIN="<desktop-development-origin>"
GOOGLE_CLIENT_ID="<google-web-client-id>"
GOOGLE_CLIENT_SECRET="<google-web-client-secret>"
GOOGLE_REDIRECT_URI="<google-callback-url>"
AUTH_STATE_SECRET="<random-signing-secret-at-least-32-characters>"
SESSION_COOKIE_SECURE="<true-for-production-false-for-loopback-development>"
SESSION_TTL_SECONDS="<session-lifetime-in-seconds>"

# Optional server-only streaming transcription configuration.
# Reuses backend GEMINI_API_KEY below. Never put provider keys in desktop/frontend.
TRANSCRIPTION_PROVIDER="gemini"
GEMINI_TRANSCRIBE_MODEL="gemini-3.5-transcribe-live"
# Dormant alternative: explicitly select deepgram to use these credentials.
DEEPGRAM_API_KEY="<your-deepgram-api-key>"
TRANSCRIPTION_MODEL="nova-3"
TRANSCRIPTION_LANGUAGE="en-US"

# Optional private Context Library storage (default: backend/.data/documents).
# CONTEXT_STORAGE_DIR=C:/path/to/private/document-volume

# Personalized Live Cue (disabled until explicitly configured; backend only).
LIVE_CUE_ENABLED=false
LIVE_CUE_PROVIDER=gemini
LIVE_CUE_MODEL=gemini-3.5-flash-lite
# GEMINI_API_KEY=your-gemini-api-key

# Optional semantic understanding; shares backend-only Gemini configuration.
GEMINI_INTENT_ENABLED=true
